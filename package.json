{
  "name": "detective-archives",
  "version": "0.1.0",
  "private": true,
  "description": "侦探档案馆：侦探作品图鉴、阅读记录与同好交流社区",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspace @detective-archives/api",
    "catalog:sync": "node scripts/sync-picture-book-index.mjs",
    "catalog:preflight": "node scripts/run-catalog-imports.mjs",
    "catalog:apply": "node scripts/run-catalog-imports.mjs --apply",
    "catalog:rollback:preflight": "node scripts/catalog-import.mjs --rollback",
    "catalog:rollback:apply": "node scripts/catalog-import.mjs --rollback --apply",
    "candidate:deploy": "sh ops/deploy-candidate.sh",
    "backup:decrypt": "node scripts/encrypted-backup.mjs decrypt",
    "backup:encrypt": "node scripts/encrypted-backup.mjs encrypt",
    "backup:verify-encrypted": "node scripts/encrypted-backup.mjs verify",
    "check": "npm run check:catalog && npm run check:directory && npm run check:expansion && npm run check:catalog-import-runner && npm run check:content-audit && npm run check:works && npm run check:admin && npm run check:miniprogram && npm run check:agreements && npm run check:miniprogram-release && npm run check:wechat-acceptance && npm run check:wechat-publication && npm run check:link-safety && npm run check:operations-drill && npm run check:backup-encryption && npm run check:production-monitoring && npm run check:infrastructure-drills && npm run check:production-release-drill && npm run check:runtime-performance-budget && npm run check:launch && npm run check:deployment && npm run typecheck && npm test && npm run build",
    "check:agreements": "node scripts/check-agreement-versioning.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:backup-encryption": "node scripts/check-backup-encryption.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:catalog-rollback": "node scripts/check-catalog-rollback.mjs",
    "check:catalog-import-runner": "node scripts/check-catalog-import-runner.mjs",
    "check:content-audit": "node scripts/check-content-audit.mjs",
    "check:db": "node scripts/db-check.mjs",
    "check:db-api": "npm run build && node scripts/check-db-api.mjs",
    "check:directory": "node scripts/check-archive-directory.mjs",
    "check:deployment": "node --check scripts/check-runtime-smoke.mjs && node --check scripts/check-runtime-performance.mjs && node scripts/check-deployment.mjs",
    "check:expansion": "node scripts/check-catalog-expansion.mjs",
    "check:infrastructure-drills": "node scripts/check-infrastructure-drills.mjs",
    "check:production-api": "npm run build && node scripts/check-api-production-config.mjs",
    "check:release-rollback": "node scripts/check-release-rollback.mjs",
    "check:performance": "node scripts/check-runtime-performance.mjs",
    "check:runtime": "node scripts/check-runtime-smoke.mjs",
    "check:miniprogram": "node scripts/check-miniprogram.mjs && node scripts/check-miniprogram-resilience.mjs",
    "check:miniprogram-release": "node scripts/check-miniprogram-release.mjs",
    "check:operations-drill": "node scripts/check-operations-drill.mjs",
    "check:production-monitoring": "node scripts/check-production-monitoring.mjs",
    "check:production-release-drill": "node scripts/check-production-release-drill.mjs",
    "check:runtime-performance-budget": "node scripts/check-runtime-performance-budget.mjs",
    "check:link-safety": "node scripts/check-link-safety.mjs",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "check:works": "node scripts/check-core-works.mjs",
    "check:wechat-acceptance": "node scripts/check-wechat-acceptance.mjs",
    "check:wechat-publication": "node scripts/check-wechat-publication.mjs",
    "config:miniprogram": "node scripts/configure-miniprogram.mjs",
    "dev:api": "npm run dev --workspace @detective-archives/api",
    "db:create": "node scripts/db-create.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed-catalog.mjs",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed && npm run catalog:apply && npm run check:db",
    "start:api": "npm run start --workspace @detective-archives/api",
    "release:check": "npm run check && node scripts/check-production-config.mjs",
    "links:check": "npm run build && node scripts/check-work-links.mjs",
    "launch:audit": "node scripts/audit-launch-readiness.mjs",
    "miniprogram:preview": "node scripts/release-miniprogram.mjs preview",
    "miniprogram:upload": "node scripts/release-miniprogram.mjs upload",
    "monitor:production": "node scripts/monitor-production.mjs",
    "monitoring:drill:record": "node scripts/record-infrastructure-drill.mjs monitoring",
    "backup:drill:record": "node scripts/record-infrastructure-drill.mjs offsite-backup",
    "operations:drill:record": "node scripts/record-operations-drill.mjs",
    "release:drill:production": "node scripts/drill-production-release.mjs",
    "wechat:acceptance:record": "node scripts/record-wechat-acceptance.mjs",
    "wechat:publication:record": "node scripts/record-wechat-publication.mjs",
    "test": "npm test --workspace @detective-archives/api",
    "typecheck": "npm run typecheck --workspace @detective-archives/api"
  },
  "engines": {
    "node": ">=22"
  }
}
