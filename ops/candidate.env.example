# 仅用于隔离候选环境。复制到仓库根目录 .env.candidate，并设置权限为 600。
# 正式生产继续使用 ops/production.env.example 和托管 PostgreSQL。
COMPOSE_PROJECT_NAME=detective-archives-candidate
API_ENV_FILE=.env.candidate
API_HOST=0.0.0.0
API_PORT=3000
API_BIND_PORT=23000
CORS_ORIGIN=https://candidate.your-domain.example
TRUST_PROXY=false
LOG_LEVEL=info

# 候选 PostgreSQL 仅在 Compose 私网中可见，不映射宿主机端口。
PGHOST=database
PGPORT=5432
PGDATABASE=detective_archives
PGUSER=detective_candidate
PGPASSWORD=replace-with-at-least-24-random-characters
PGSSLMODE=disable
DETECTIVE_DB_NAME=detective_archives
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

SESSION_TTL_SECONDS=2592000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# 使用真实候选 AppID/AppSecret 才能验证微信链路；随机测试身份只能验证非微信运行路径。
WECHAT_APP_ID=wx-replace-with-candidate-appid
WECHAT_APP_SECRET=replace-with-candidate-appsecret
WECHAT_DEV_LOGIN=false

ADMIN_LOGIN_ID=candidate-operator
ADMIN_LOGIN_PASSWORD=replace-with-at-least-16-random-characters
METRICS_AUTH_TOKEN=replace-with-at-least-24-random-characters

# 每次部署都更新为当前完整提交号及对应不可变镜像标签。
SOURCE_COMMIT=replace-with-40-character-git-commit
IMAGE_TAG=candidate-replace-with-short-commit
