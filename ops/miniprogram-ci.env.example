# 仅用于专用小程序发布终端或隔离 CI Runner；不要把真实私钥复制进仓库。
MINIPROGRAM_APP_ID=wx-replace-with-real-appid
MINIPROGRAM_PRIVATE_KEY_PATH=/run/secrets/private.wx-replace-with-real-appid.key
MINIPROGRAM_VERSION=0.1.0-rc.1
MINIPROGRAM_RELEASE_DESC=侦探档案馆 0.1.0 候选
MINIPROGRAM_CI_ROBOT=1

# 预览二维码必须写到仓库外，并按敏感临时文件管理。
MINIPROGRAM_QR_OUTPUT=/run/release-artifacts/detective-archives-0.1.0-rc.1.jpg

# 上传成功后，工具只更新实际清单，不会改写示例文件。
LAUNCH_READINESS_FILE=ops/launch-readiness.json
