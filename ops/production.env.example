# 复制到仓库根目录 .env.production，权限设置为仅部署用户可读。
API_HOST=0.0.0.0
API_PORT=3000
# 宿主机回环端口；共享服务器发生冲突时可改为其他未占用端口，并同步提供给 Caddy。
API_BIND_PORT=3000
CORS_ORIGIN=https://api.your-domain.example
TRUST_PROXY=true
LOG_LEVEL=info

DATABASE_URL=postgresql://user:strong-password@managed-postgres:5432/detective_archives
PGSSLMODE=verify-full
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
BACKUP_DIRECTORY=/var/backups/detective-archives
BACKUP_RETENTION_DAYS=14

SESSION_TTL_SECONDS=2592000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

WECHAT_APP_ID=wx-replace-with-real-appid
WECHAT_APP_SECRET=replace-with-real-appsecret
WECHAT_DEV_LOGIN=false

# 小程序构建信息；MINIPROGRAM_APP_ID 必须与 WECHAT_APP_ID 完全一致。
MINIPROGRAM_APP_ID=wx-replace-with-real-appid
PUBLIC_API_BASE_URL=https://api.your-domain.example
OPERATOR_NAME=上线前填写真实运营主体全称
PRIVACY_CONTACT=上线前填写真实隐私联系人
LAUNCH_READINESS_FILE=ops/launch-readiness.json

ADMIN_LOGIN_ID=replace-with-operations-login
ADMIN_LOGIN_PASSWORD=replace-with-at-least-16-random-characters
METRICS_AUTH_TOKEN=replace-with-at-least-24-random-characters
