API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGIN=*
DATABASE_URL=postgresql://detective:change-me@127.0.0.1:5432/detective_archives
DETECTIVE_DB_NAME=detective_archives
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
SESSION_TTL_SECONDS=2592000
WECHAT_APP_ID=replace-with-miniprogram-appid
WECHAT_APP_SECRET=replace-with-miniprogram-secret
# 仅允许本地开发使用；生产环境必须保持 false
WECHAT_DEV_LOGIN=false
WECHAT_DEV_SUBJECT=local-user
# 后台账号需单独配置；生产密码至少 16 位
ADMIN_LOGIN_ID=
ADMIN_LOGIN_PASSWORD=
