<view class="page-shell">
  <text class="eyebrow">ARCHIVE SEARCH</text>
  <view class="section-title">{{sectionTitle}}</view>

  <view class="catalog-tabs">
    <view
      wx:for="{{sections}}"
      wx:key="id"
      class="catalog-tab {{activeSection === item.id ? 'active' : ''}}"
      data-section="{{item.id}}"
      bindtap="onSectionChange"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{coverageText}}" class="coverage-note">
    {{coverageText}}
  </view>

  <view class="search-box">
    <input
      class="search-input"
      placeholder="{{searchPlaceholder}}"
      value="{{query}}"
      confirm-type="search"
      bindinput="onQueryInput"
      bindconfirm="onSearch"
    />
    <text wx:if="{{query}}" class="clear" bindtap="onClear">清除</text>
    <text class="search-action" bindtap="onSearch">搜索</text>
  </view>

  <block wx:if="{{activeSection === 'detectives'}}">
    <view class="filter-toolbar">
      <view class="filter-toggle {{selectedFilterCount ? 'active' : ''}}" bindtap="onToggleFilters">
        筛选{{selectedFilterCount ? ' · ' + selectedFilterCount : ''}}
      </view>
      <view wx:if="{{selectedFilterCount}}" class="filter-clear" bindtap="onClearFilters">重置筛选</view>
    </view>
    <view wx:if="{{filtersVisible}}" class="filter-panel">
      <picker
        wx:for="{{filterFields}}"
        wx:key="key"
        mode="selector"
        range="{{item.options}}"
        range-key="label"
        value="{{item.selectedIndex}}"
        data-key="{{item.key}}"
        bindchange="onFilterChange"
      >
        <view class="filter-field {{item.active ? 'active' : ''}}">
          <text class="filter-field-label">{{item.label}}</text>
          <text class="filter-field-value">{{item.selectedLabel}}</text>
          <text class="filter-field-arrow">›</text>
        </view>
      </picker>
    </view>
  </block>

  <view wx:if="{{loading}}" class="state-message">正在检索档案…</view>
  <view wx:elif="{{error}}" class="state-message">{{error}}</view>
  <view wx:elif="{{!entries.length}}" class="state-message">没有找到匹配档案</view>
  <view wx:else class="result-list">
    <block wx:if="{{activeSection === 'detectives'}}">
      <view
        wx:for="{{entries}}"
        wx:key="id"
        class="card result-card directory-card"
        data-slug="{{item.slug}}"
        bindtap="openEntry"
      >
        <view class="archive-badge {{item.subjectKind === 'HISTORICAL' ? 'historical' : ''}}">
          {{item.subjectKind === 'HISTORICAL' ? '史实' : '侦探'}}
        </view>
        <view class="result-main">
          <view class="result-title-row">
            <view class="result-name">{{item.nameZh}}</view>
          </view>
          <view class="muted result-meta">{{item.nameOriginal}} · {{item.country}}</view>
          <view wx:if="{{item.creatorName}}" class="muted result-meta">创作者 {{item.creatorName}}</view>
          <view class="result-summary">{{item.summary}}</view>
          <view wx:if="{{item.works.length}}" class="featured-work">代表作品：{{item.works[0].titleZh}}</view>
        </view>
        <view class="detail-state ready">查看档案</view>
      </view>
    </block>

    <block wx:elif="{{activeSection === 'pictureBook'}}">
      <view
        wx:for="{{entries}}"
        wx:key="id"
        class="card result-card"
        data-id="{{item.id}}"
        data-name="{{item.names.zh}}"
        data-slug="{{item.detectiveSlug}}"
        bindtap="openEntry"
      >
        <view class="volume-badge">
          <text class="volume-number">{{item.volumeNo}}</text>
          <text class="volume-label">卷</text>
        </view>
        <view class="result-main">
          <view class="result-title-row">
            <view class="result-name">{{item.names.zh}}</view>
            <text wx:if="{{item.edition === 'SPECIAL'}}" class="edition-tag">特装版</text>
          </view>
          <view class="muted result-meta">编号 {{item.id}}</view>
          <view wx:if="{{item.recommendedWorks.length}}" class="result-summary">
            推荐作品：{{item.recommendedWorks[0]}}
          </view>
          <view wx:else class="result-summary pending">推荐作品待核验</view>
        </view>
        <view wx:if="{{item.detectiveSlug}}" class="detail-state ready">查看档案</view>
        <view wx:else class="detail-state">待补全</view>
      </view>
    </block>

    <block wx:else>
      <view
        wx:for="{{entries}}"
        wx:key="id"
        class="card result-card directory-card"
        data-id="{{item.id}}"
        data-name="{{item.names.zh}}"
        bindtap="openEntry"
      >
        <view class="archive-badge {{item.collection === 'HISTORICAL_CASES' ? 'historical' : ''}}">
          {{item.collectionLabel}}
        </view>
        <view class="result-main">
          <view class="result-title-row">
            <view class="result-name">{{item.names.zh}}</view>
            <text class="directory-category">{{item.categoryLabel}}</text>
          </view>
          <view class="muted result-meta">{{item.names.original}} · {{item.region}}</view>
          <view wx:if="{{item.creatorName}}" class="muted result-meta">创作者 {{item.creatorName}}</view>
          <view class="result-summary">{{item.summary}}</view>
          <view class="featured-work">
            {{item.collection === 'HISTORICAL_CASES' ? '相关文献' : '代表作品'}}：{{item.featuredWorks[0]}}
          </view>
        </view>
        <view class="detail-state ready">查看简介</view>
      </view>
    </block>
  </view>

  <view
    wx:if="{{activeSection === 'detectives' && entries.length && hasMore}}"
    class="load-more {{loadingMore ? 'disabled' : ''}}"
    bindtap="onLoadMore"
  >{{loadingMore ? '正在加载更多…' : '加载更多档案'}}</view>
  <view
    wx:elif="{{activeSection === 'detectives' && entries.length && !loading && !hasMore}}"
    class="list-complete"
  >已展示全部 {{coverage.total}} 位人物</view>
</view>
