.search-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 28rpx 0 36rpx;
  padding: 6rpx 22rpx 6rpx 28rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 12rpx;
  background: #fffaf0;
}

.coverage-note {
  margin-top: 18rpx;
  color: #777269;
  font-size: 24rpx;
}

.catalog-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 8rpx;
  border: 1rpx solid #d9cdbb;
  border-radius: 14rpx;
  background: #e9dfcf;
}

.catalog-tab {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 10rpx;
  color: #696259;
  font-size: 21rpx;
  text-align: center;
}

.catalog-tab.active {
  background: #fffaf0;
  color: #9f3123;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(62, 50, 39, 0.08);
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 27rpx;
}

.clear {
  color: #8d857a;
  font-size: 23rpx;
}

.search-action {
  color: #9f3123;
  font-size: 26rpx;
  font-weight: 700;
}

.filter-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -16rpx 0 24rpx;
}

.filter-toggle,
.filter-clear {
  color: #756b5f;
  font-size: 23rpx;
}

.filter-toggle {
  padding: 12rpx 20rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 999rpx;
  background: #fffaf0;
}

.filter-toggle.active,
.filter-clear {
  color: #9f3123;
}

.filter-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: -8rpx 0 30rpx;
  padding: 20rpx;
  border: 1rpx solid #d9cdbb;
  border-radius: 14rpx;
  background: #eee5d7;
}

.filter-field {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #fffaf0;
  color: #6f675e;
}

.filter-field.active {
  box-shadow: inset 4rpx 0 #9f3123;
  color: #8b3023;
}

.filter-field-label {
  width: 150rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.filter-field-value {
  flex: 1;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-field-arrow {
  width: 30rpx;
  color: #998d7d;
  font-size: 36rpx;
  text-align: right;
}

.load-more,
.list-complete {
  margin: 30rpx 0 10rpx;
  padding: 24rpx;
  color: #9f3123;
  font-size: 24rpx;
  text-align: center;
}

.load-more {
  border: 1rpx solid #cfc1ac;
  border-radius: 12rpx;
  background: #fffaf0;
  font-weight: 700;
}

.load-more.disabled,
.list-complete {
  color: #938a7e;
}

.result-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.directory-card {
  align-items: flex-start;
}

.archive-badge {
  min-width: 70rpx;
  padding: 14rpx 8rpx;
  border: 1rpx solid #9f3123;
  border-radius: 10rpx;
  color: #9f3123;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.archive-badge.historical {
  border-color: #586b59;
  color: #586b59;
}

.volume-badge {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b9ad9a;
  border-radius: 50%;
  color: #9f3123;
}

.volume-number {
  font-family: Georgia, serif;
  font-size: 27rpx;
  line-height: 1;
}

.volume-label {
  margin-top: 4rpx;
  color: #777269;
  font-size: 17rpx;
}

.result-main {
  flex: 1;
}

.result-name {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edition-tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #9f3123;
  color: #fffaf0;
  font-size: 18rpx;
}

.directory-category {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #e8ddcb;
  color: #6f6254;
  font-size: 18rpx;
}

.result-meta {
  margin-top: 7rpx;
  font-size: 23rpx;
}

.result-summary {
  margin-top: 16rpx;
  color: #5f5a52;
  font-size: 25rpx;
  line-height: 1.55;
}

.result-summary.pending {
  color: #9a9185;
}

.featured-work {
  margin-top: 12rpx;
  color: #8b3a2c;
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-state {
  min-width: 86rpx;
  color: #9a9185;
  font-size: 21rpx;
  text-align: center;
}

.detail-state.ready {
  color: #9f3123;
  font-weight: 700;
}
