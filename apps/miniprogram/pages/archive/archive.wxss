.search-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 28rpx 0 36rpx;
  padding: 6rpx 22rpx 6rpx 28rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 12rpx;
  background: #fffaf0;
}

.coverage-note {
  margin-top: 18rpx;
  color: #777269;
  font-size: 24rpx;
}

.catalog-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 8rpx;
  border: 1rpx solid #d9cdbb;
  border-radius: 14rpx;
  background: #e9dfcf;
}

.catalog-tab {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 10rpx;
  color: #696259;
  font-size: 23rpx;
  text-align: center;
}

.catalog-tab.active {
  background: #fffaf0;
  color: #9f3123;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(62, 50, 39, 0.08);
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 27rpx;
}

.clear {
  color: #8d857a;
  font-size: 23rpx;
}

.search-action {
  color: #9f3123;
  font-size: 26rpx;
  font-weight: 700;
}

.result-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.directory-card {
  align-items: flex-start;
}

.archive-badge {
  min-width: 70rpx;
  padding: 14rpx 8rpx;
  border: 1rpx solid #9f3123;
  border-radius: 10rpx;
  color: #9f3123;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.archive-badge.historical {
  border-color: #586b59;
  color: #586b59;
}

.volume-badge {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b9ad9a;
  border-radius: 50%;
  color: #9f3123;
}

.volume-number {
  font-family: Georgia, serif;
  font-size: 27rpx;
  line-height: 1;
}

.volume-label {
  margin-top: 4rpx;
  color: #777269;
  font-size: 17rpx;
}

.result-main {
  flex: 1;
}

.result-name {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edition-tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #9f3123;
  color: #fffaf0;
  font-size: 18rpx;
}

.directory-category {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #e8ddcb;
  color: #6f6254;
  font-size: 18rpx;
}

.result-meta {
  margin-top: 7rpx;
  font-size: 23rpx;
}

.result-summary {
  margin-top: 16rpx;
  color: #5f5a52;
  font-size: 25rpx;
  line-height: 1.55;
}

.result-summary.pending {
  color: #9a9185;
}

.featured-work {
  margin-top: 12rpx;
  color: #8b3a2c;
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-state {
  min-width: 86rpx;
  color: #9a9185;
  font-size: 21rpx;
  text-align: center;
}

.detail-state.ready {
  color: #9f3123;
  font-weight: 700;
}
