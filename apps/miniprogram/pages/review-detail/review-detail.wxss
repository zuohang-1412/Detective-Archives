.review-head {
  margin: -32rpx -28rpx 38rpx;
  padding: 60rpx 40rpx 45rpx;
  background: #101820;
  color: #fffaf0;
}

.review-title {
  margin-top: 18rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
}

.author-line {
  margin-top: 22rpx;
  color: rgba(255, 250, 240, 0.65);
  font-size: 24rpx;
}

.review-body {
  font-size: 29rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.spoiler-panel {
  padding: 70rpx 30rpx;
  border-radius: 14rpx;
  background: #e6dac8;
  text-align: center;
}

.spoiler-title {
  font-size: 29rpx;
  font-weight: 700;
}

.spoiler-copy {
  margin-top: 10rpx;
  color: #777269;
  font-size: 22rpx;
}

.review-actions,
.comment-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 26rpx;
  color: #777269;
  font-size: 23rpx;
}

.action.active,
.comment-actions .active {
  color: #9f3123;
  font-weight: 700;
}

.discussion {
  margin-top: 60rpx;
}

.empty-comments {
  padding: 30rpx 0;
  color: #777269;
  font-size: 24rpx;
}

.load-more {
  margin: 24rpx 0 0;
  border: 1rpx solid #bbae99;
  border-radius: 9rpx;
  background: transparent;
  color: #6d655b;
  font-size: 23rpx;
}

.load-more::after {
  border: 0;
}

.comment-card {
  padding: 28rpx 0;
  border-top: 1rpx solid #d8cbb8;
}

.comment-author {
  color: #9f3123;
  font-size: 23rpx;
  font-weight: 700;
}

.comment-body,
.comment-spoiler {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.comment-spoiler {
  padding: 20rpx;
  border-radius: 8rpx;
  background: #e6dac8;
  color: #756d62;
  text-align: center;
}

.reply-editor {
  margin-top: 34rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #bdae99;
}

.reply-target {
  margin-bottom: 12rpx;
  color: #777269;
  font-size: 22rpx;
}

.reply-target text {
  margin-left: 18rpx;
  color: #9f3123;
}

.comment-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 11rpx;
  background: #fffaf0;
  font-size: 25rpx;
  line-height: 1.65;
}

.reply-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.spoiler-switch {
  display: flex;
  align-items: center;
  color: #777269;
  font-size: 22rpx;
}

.reply-button {
  width: 210rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #9f3123;
  color: #fffaf0;
  font-size: 24rpx;
}

.reply-button::after {
  border: 0;
}

.report-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 24, 32, 0.58);
}

.report-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 24rpx 24rpx 0 0;
  background: #f6efe3;
}

.report-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.report-title {
  margin-top: 8rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 38rpx;
  font-weight: 700;
}

.report-close {
  padding: 10rpx 0 10rpx 20rpx;
  color: #777269;
  font-size: 23rpx;
}

.report-hint {
  margin-top: 22rpx;
  color: #6d655b;
  font-size: 23rpx;
  line-height: 1.65;
}

.report-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.report-reason {
  box-sizing: border-box;
  width: calc(50% - 7rpx);
  padding: 20rpx 14rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 10rpx;
  background: #fffaf0;
  color: #524c44;
  font-size: 23rpx;
  text-align: center;
}

.report-reason.selected {
  border-color: #9f3123;
  background: #9f3123;
  color: #fffaf0;
}

.report-description {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 10rpx;
  background: #fffaf0;
  font-size: 24rpx;
  line-height: 1.65;
}

.report-length {
  margin-top: 8rpx;
  color: #8a8176;
  font-size: 20rpx;
  text-align: right;
}

.report-submit {
  margin-top: 22rpx;
  border-radius: 10rpx;
  background: #9f3123;
  color: #fffaf0;
  font-size: 25rpx;
}

.report-submit[disabled] {
  background: #c8bdb0;
  color: #f6efe3;
}

.report-submit::after {
  border: 0;
}
