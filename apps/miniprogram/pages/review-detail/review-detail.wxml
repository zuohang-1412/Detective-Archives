<view class="page-shell">
  <view wx:if="{{loading}}" class="state-message">正在展开读者笔记…</view>
  <view wx:elif="{{error}}" class="state-message">
    <view class="state-copy">{{error}}</view>
    <view class="state-actions">
      <button wx:if="{{reviewId}}" class="state-action" bindtap="loadReview">重新读取</button>
      <button class="state-action secondary" bindtap="goBack">返回上一页</button>
    </view>
  </view>
  <block wx:elif="{{review}}">
    <view class="review-head">
      <text class="eyebrow">READER NOTE</text>
      <view wx:if="{{review.title}}" class="review-title">{{review.title}}</view>
      <view class="author-line">{{review.author.displayName}}<text wx:if="{{review.rating}}"> · {{review.rating}} / 5</text></view>
    </view>

    <view
      wx:if="{{review.containsSpoiler && !spoilerRevealed}}"
      class="spoiler-panel"
      bindtap="revealReview"
    >
      <view class="spoiler-title">这篇评价包含剧透</view>
      <view class="spoiler-copy">轻触后展开正文</view>
    </view>
    <view wx:else class="review-body">{{review.body}}</view>

    <view class="review-actions">
      <text class="action {{review.likedByMe ? 'active' : ''}}" bindtap="toggleReviewLike">赞 {{review.likeCount}}</text>
      <text wx:if="{{review.isMine}}" class="action" bindtap="editReview">编辑</text>
      <text wx:if="{{review.isMine}}" class="action" bindtap="deleteOwnReview">删除</text>
      <text wx:else class="action" bindtap="reportReview">举报</text>
    </view>

    <view class="discussion">
      <text class="eyebrow">DISCUSSION</text>
      <view class="section-title">回复 {{review.commentCount}}</view>
      <view wx:if="{{!review.comments.length}}" class="empty-comments">还没有公开回复。</view>
      <view wx:for="{{review.comments}}" wx:key="id" class="comment-card">
        <view class="comment-author">{{item.author.displayName}}</view>
        <view
          wx:if="{{item.containsSpoiler && !item.spoilerRevealed}}"
          class="comment-spoiler"
          data-index="{{index}}"
          bindtap="revealComment"
        >含剧透，轻触展开</view>
        <view wx:else class="comment-body">{{item.body}}</view>
        <view class="comment-actions">
          <text
            class="{{item.likedByMe ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="toggleCommentLike"
          >赞 {{item.likeCount}}</text>
          <text data-comment-id="{{item.id}}" data-author="{{item.author.displayName}}" bindtap="chooseReply">回复</text>
          <text wx:if="{{item.isMine}}" data-comment-id="{{item.id}}" bindtap="deleteOwnComment">删除</text>
          <text wx:else data-comment-id="{{item.id}}" bindtap="reportComment">举报</text>
        </view>
      </view>
      <button
        wx:if="{{commentsHasMore}}"
        class="load-more"
        loading="{{commentsLoading}}"
        bindtap="loadMoreComments"
      >加载更多回复</button>
    </view>

    <view class="reply-editor">
      <view wx:if="{{replyTo}}" class="reply-target">
        回复 {{replyTo.author}} <text bindtap="cancelReply">取消</text>
      </view>
      <textarea
        class="comment-input"
        maxlength="1000"
        auto-height
        placeholder="友善地加入讨论…"
        value="{{commentBody}}"
        bindinput="inputComment"
      />
      <view class="reply-controls">
        <label class="spoiler-switch">
          <switch color="#9f3123" checked="{{commentSpoiler}}" bindchange="changeCommentSpoiler" />
          <text>含剧透</text>
        </label>
        <button class="reply-button" loading="{{submitting}}" bindtap="submitComment">提交回复</button>
      </view>
    </view>
  </block>

  <view wx:if="{{reportOpen}}" class="report-mask" catchtap="closeReport">
    <view class="report-sheet" catchtap="keepReportOpen">
      <view class="report-heading">
        <view>
          <text class="eyebrow">REPORT</text>
          <view class="report-title">提交举报线索</view>
        </view>
        <text class="report-close" catchtap="closeReport">关闭</text>
      </view>
      <view class="report-hint">请选择最符合的原因。补充说明仅供审核人员处理，不会公开展示。</view>
      <view class="report-reasons">
        <view
          wx:for="{{reportReasons}}"
          wx:key="code"
          class="report-reason {{reportReasonCode === item.code ? 'selected' : ''}}"
          data-code="{{item.code}}"
          bindtap="selectReportReason"
        >{{item.label}}</view>
      </view>
      <textarea
        class="report-description"
        maxlength="500"
        placeholder="补充时间、位置或具体问题（选填）"
        value="{{reportDescription}}"
        bindinput="inputReportDescription"
      />
      <view class="report-length">{{reportDescription.length}} / 500</view>
      <button
        class="report-submit"
        disabled="{{!reportReasonCode || reportSubmitting}}"
        loading="{{reportSubmitting}}"
        bindtap="submitReport"
      >提交举报</button>
    </view>
  </view>
</view>
