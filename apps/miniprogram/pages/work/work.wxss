.work-head {
  margin: -32rpx -28rpx 48rpx;
  padding: 64rpx 40rpx 54rpx;
  background: #101820;
  color: #fffaf0;
}

.work-title {
  margin-top: 20rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.25;
}

.work-original {
  margin-top: 10rpx;
  color: #d7a84b;
  font-size: 25rpx;
  line-height: 1.5;
}

.work-meta,
.creator-line {
  margin-top: 24rpx;
  color: rgba(255, 250, 240, 0.68);
  font-size: 24rpx;
}

.creator-line {
  margin-top: 8rpx;
}

.content-section {
  margin-bottom: 48rpx;
}

.review-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.write-review {
  margin-bottom: 30rpx;
  color: #9f3123;
  font-size: 25rpx;
  font-weight: 700;
}

.review-empty {
  padding: 34rpx 0;
  color: #777269;
  font-size: 24rpx;
  line-height: 1.6;
}

.review-meta,
.review-stats {
  display: flex;
  justify-content: space-between;
  color: #777269;
  font-size: 21rpx;
}

.review-title {
  margin-top: 17rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.review-body,
.spoiler-cover {
  margin-top: 17rpx;
  font-size: 25rpx;
  line-height: 1.7;
}

.spoiler-cover {
  padding: 26rpx;
  border-radius: 9rpx;
  background: #e7dccb;
  color: #786f64;
  text-align: center;
}

.review-stats {
  margin-top: 20rpx;
  justify-content: flex-start;
  color: #9f3123;
}

.summary {
  color: #4e4a44;
  font-size: 28rpx;
  line-height: 1.85;
}

.shelf-actions {
  display: flex;
  gap: 14rpx;
}

.shelf-button {
  flex: 1;
  margin: 0;
  border: 1rpx solid #bbae99;
  border-radius: 10rpx;
  background: #fffaf0;
  color: #625b52;
  font-size: 25rpx;
}

.shelf-button::after {
  border: 0;
}

.shelf-button.active {
  border-color: #9f3123;
  background: #9f3123;
  color: #fffaf0;
}

.shelf-current {
  margin-top: 18rpx;
  color: #777269;
  font-size: 23rpx;
}

.remove-shelf {
  margin-left: 24rpx;
  color: #9f3123;
}

.detective-link,
.official-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detective-link {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 31rpx;
  font-weight: 700;
}

.arrow {
  color: #9f3123;
  font-size: 42rpx;
}

.link-note,
.empty-links {
  margin: -8rpx 0 24rpx;
  color: #777269;
  font-size: 23rpx;
  line-height: 1.6;
}

.official-link {
  margin-bottom: 18rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #cfc1ac;
  border-radius: 14rpx;
  background: #fffaf0;
}

.provider-name {
  font-size: 28rpx;
  font-weight: 700;
}

.provider-meta {
  margin-top: 7rpx;
  color: #777269;
  font-size: 21rpx;
}

.copy-action,
.retry {
  color: #9f3123;
  font-size: 24rpx;
  font-weight: 700;
}

.retry {
  margin-top: 12rpx;
}
