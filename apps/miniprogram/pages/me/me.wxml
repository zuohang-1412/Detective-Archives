<view class="page-shell">
  <view class="profile-panel">
    <text class="eyebrow">MY DETECTIVE ARCHIVES</text>
    <view class="profile-title">我的档案馆</view>
    <block wx:if="{{loggedIn}}">
      <view class="profile-name">{{user.displayName}}</view>
      <view class="profile-copy">把想读、在读和已经完成的推理作品收进同一份私人档案。</view>
      <text class="logout" bindtap="confirmLogout">退出登录</text>
    </block>
    <block wx:else>
      <view class="profile-copy">登录后记录阅读或观看进度，之后还能在作品下留下短评与长评。</view>
      <button class="login-button" loading="{{loggingIn}}" bindtap="login">微信快捷登录</button>
      <checkbox-group class="agreement-row" bindchange="toggleAgreements">
        <label>
          <checkbox value="accepted" color="#9f3123" checked="{{agreementsAccepted}}" />
          <text>我已阅读并同意</text>
        </label>
        <text class="legal-link" data-type="terms" catchtap="openLegal">《用户协议》</text>
        <text>和</text>
        <text class="legal-link" data-type="privacy" catchtap="openLegal">《隐私政策》</text>
      </checkbox-group>
    </block>
  </view>

  <view wx:if="{{error}}" class="error-note">{{error}}</view>

  <view wx:if="{{loadError}}" class="state-message">
    <view class="state-copy">{{loadError}}</view>
    <view class="state-actions">
      <button class="state-action" bindtap="refresh">重新读取</button>
      <button class="state-action secondary" bindtap="goArchive">前往档案室</button>
    </view>
  </view>

  <block wx:if="{{loggedIn && !loadError}}">
    <view class="shelf-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="status"
        class="shelf-tab {{activeStatus === item.status ? 'active' : ''}}"
        data-status="{{item.status}}"
        bindtap="changeTab"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{loading}}" class="state-message">正在整理私人档案…</view>
    <view wx:elif="{{!items.length}}" class="empty-state">
      <view class="empty-title">这里还没有作品</view>
      <view class="empty-copy">从侦探详情进入作品页，就可以加入想读、在读或已读。</view>
      <button class="archive-button" bindtap="goArchive">去档案室发现作品</button>
    </view>
    <view wx:else>
      <view wx:for="{{items}}" wx:key="id" class="card shelf-card">
        <view
          class="shelf-main"
          data-work-id="{{item.workId}}"
          data-slug="{{item.work.slug}}"
          bindtap="openWork"
        >
          <view class="shelf-title">{{item.work.titleZh}}</view>
          <view class="shelf-original">{{item.work.titleOriginal}}</view>
          <view class="shelf-meta">{{item.work.releaseYear}} · 进度 {{item.progressPercent}}%</view>
          <view wx:if="{{!item.work.isAvailable}}" class="shelf-unavailable">作品资料暂不可用，阅读记录已保留</view>
        </view>
        <view
          wx:if="{{item.work.isAvailable}}"
          class="status-badge"
          data-work-id="{{item.workId}}"
          bindtap="changeStatus"
        >{{item.statusLabel}}</view>
        <view wx:else class="unavailable-actions">
          <view class="status-badge muted">{{item.statusLabel}}</view>
          <text
            class="remove-unavailable"
            data-work-id="{{item.workId}}"
            catchtap="removeUnavailableShelf"
          >{{shelfActionId === item.workId ? '移除中…' : '移除'}}</text>
        </view>
      </view>
    </view>

    <view class="my-reviews">
      <text class="eyebrow">MY REVIEWS</text>
      <view class="section-title">我的评价</view>
      <view wx:if="{{!reviews.length}}" class="review-empty">还没有写过评价。</view>
      <view
        wx:for="{{reviews}}"
        wx:key="id"
        class="card my-review-card"
      >
        <view
          class="review-main"
          data-review-id="{{item.id}}"
          data-status="{{item.status}}"
          bindtap="openMyReview"
        >
          <view class="review-work">{{item.work.titleZh}}</view>
          <view wx:if="{{item.title}}" class="review-title">{{item.title}}</view>
          <view class="review-excerpt">{{item.body}}</view>
          <view wx:if="{{item.appealStatusLabel}}" class="appeal-status">{{item.appealStatusLabel}}</view>
          <view class="review-controls">
            <text data-review-id="{{item.id}}" catchtap="editMyReview">编辑</text>
            <text
              wx:if="{{item.canAppeal}}"
              class="review-appeal"
              data-review-id="{{item.id}}"
              catchtap="appealMyReview"
            >{{appealActionId === item.id ? '提交中…' : '申请复核'}}</text>
            <text
              class="review-delete"
              data-review-id="{{item.id}}"
              catchtap="deleteMyReview"
            >{{reviewActionId === item.id ? '删除中…' : '删除'}}</text>
          </view>
        </view>
        <view class="review-status {{item.status === 'PUBLISHED' ? 'published' : ''}}">{{item.statusLabel}}</view>
      </view>
    </view>

    <view class="account-settings">
      <text class="legal-link" data-type="terms" bindtap="openLegal">用户协议</text>
      <text class="legal-link" data-type="privacy" bindtap="openLegal">隐私政策</text>
      <text class="deactivate-link" bindtap="confirmDeactivate">注销账号</text>
    </view>
  </block>
</view>
