.hero {
  position: relative;
  overflow: hidden;
  margin: -32rpx -28rpx 52rpx;
  padding: 72rpx 44rpx 64rpx;
  background: #101820;
  color: #fffaf0;
}

.hero::after {
  position: absolute;
  right: -100rpx;
  bottom: -180rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255, 250, 240, 0.18);
  border-radius: 50%;
  content: "";
}

.hero-kicker,
.hero-title,
.hero-copy {
  position: relative;
  z-index: 1;
  display: block;
}

.hero-kicker {
  color: #d7a84b;
  font-size: 21rpx;
  letter-spacing: 5rpx;
}

.hero-title {
  max-width: 620rpx;
  margin-top: 28rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-copy {
  max-width: 610rpx;
  margin-top: 22rpx;
  color: rgba(255, 250, 240, 0.7);
  font-size: 27rpx;
  line-height: 1.75;
}

.primary-button {
  position: relative;
  z-index: 1;
  width: 250rpx;
  margin: 40rpx 0 0;
  border-radius: 8rpx;
  background: #9f3123;
  color: #fffaf0;
  font-size: 27rpx;
}

.primary-button::after {
  border: 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.text-link,
.retry-text {
  color: #9f3123;
  font-size: 25rpx;
  font-weight: 600;
}

.detective-card {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.card-index {
  color: #b9ad9a;
  font-family: Georgia, serif;
  font-size: 28rpx;
}

.card-body {
  flex: 1;
}

.detective-name {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.original-name {
  margin-top: 4rpx;
  color: #9f3123;
  font-size: 23rpx;
}

.summary {
  margin-top: 18rpx;
  color: #5f5a52;
  font-size: 26rpx;
  line-height: 1.65;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eee2cf;
  color: #61594e;
  font-size: 21rpx;
}

.arrow {
  color: #9f3123;
  font-size: 44rpx;
}

.retry-text {
  margin-top: 12rpx;
}
