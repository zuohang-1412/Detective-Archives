page {
  min-height: 100%;
  background: #f2eadb;
  color: #182026;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  padding: 32rpx 28rpx 60rpx;
}

.eyebrow {
  color: #9f3123;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.section-title {
  margin: 12rpx 0 24rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(24, 32, 38, 0.12);
  border-radius: 18rpx;
  background: #fffaf0;
  box-shadow: 0 10rpx 28rpx rgba(24, 32, 38, 0.07);
}

.muted {
  color: #777269;
}

.state-message {
  padding: 72rpx 24rpx;
  color: #777269;
  text-align: center;
}

.state-copy {
  line-height: 1.65;
}

.state-actions {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 28rpx;
}

.state-action {
  min-width: 200rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 9rpx;
  background: #9f3123;
  color: #fffaf0;
  font-size: 24rpx;
  line-height: 72rpx;
}

.state-action.secondary {
  border: 1rpx solid #b9aa94;
  background: transparent;
  color: #6d655b;
}

.state-action::after {
  border: 0;
}
