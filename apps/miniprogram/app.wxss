page {
  min-height: 100%;
  background: #f2eadb;
  color: #182026;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  padding: 32rpx 28rpx 60rpx;
}

.eyebrow {
  color: #9f3123;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.section-title {
  margin: 12rpx 0 24rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(24, 32, 38, 0.12);
  border-radius: 18rpx;
  background: #fffaf0;
  box-shadow: 0 10rpx 28rpx rgba(24, 32, 38, 0.07);
}

.muted {
  color: #777269;
}

.state-message {
  padding: 72rpx 24rpx;
  color: #777269;
  text-align: center;
}
